Bootstrap: docker
From: ${BASE_IMAGE}

# The hybrid-architecture image with every feature's dependencies, on NeMo's framework image
# (nvcr.io/nvidia/nemo:26.08.01) instead of NGC PyTorch (MegatronTraining-hybrid-ep.def.in).
# NeMo 26.08.01 (on NGC PyTorch 26.06) already ships in its uv venv /opt/venv: torch 2.13,
# TE 2.18, Python 3.12, CUDA 13.3, DeepEP/HybridEP at the commit Megatron v0.19 is tested
# with (1.2.1+de0dd11) with NVSHMEM 3.6, mamba-ssm 2.3.2.post1 + causal-conv1d 1.6.2,
# NVRx 0.6.0, emerging-optimizers 0.2.0 -- those are reused as they are. Added here:
#   - oellm-autoexp; its Megatron (submodules/Megatron-LM) on PYTHONPATH, NeMo's bundled
#     megatron-core removed so it cannot shadow ours;
#   - the CuTe DSL / TileLang versions our kernels and FLA's TileLang paths need (NeMo's are
#     older), cute-triadic-gdn, Liger, power retention (+ vidrial's CUTLASS checkout);
#   - MoonEP and UCCL-EP (best effort);
#   - HybridEP's JIT cache on a writable path, the venv first on PATH at run time.
# FLA (the ComplexKDA fork) and cute_kernels stay outside the image, on PYTHONPATH, as for
# the other hybrid images.
#
# Build:  DEFINITION=MegatronTraining_NeMo_hybrid container/megatron/build_hybrid.sh [OUTPUT_DIR]
#         (BASE_IMAGE defaults to nvcr.io/nvidia/nemo:26.08.01 for this definition)
#
# Only shell forms that build_container.sh's envsubst leaves alone are used in %post:
# literals, command substitutions, defaulted expansions and heredocs (envsubst blanks any
# plain variable reference).

%labels
    Author OpenSci
    Version 0.1.0
    Base ${BASE_IMAGE}
    Description Megatron hybrid-architecture container on NeMo (26.08.01: torch 2.13, TE 2.18, DeepEP/HybridEP, mamba_ssm, NVRx), CuTe DSL + cute-triadic-gdn, TileLang, power retention, Liger, MoonEP, UCCL-EP

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/workspace/oellm-autoexp:${PYTHONPATH:-}
    export OELLM_AUTOEXP_CACHE=/workspace/cache
    export HF_HOME=/workspace/cache/hf
    # NeMo's HybridEP is built with its multi-node (RDMA) path; intra-node EP does not use it.
    export HYBRID_EP_MULTINODE=1

%files
    ${REPO_ROOT} /workspace/oellm-autoexp
    ${REQUIREMENTS_PATH} /workspace/${REQUIREMENTS_BASENAME}
    ${PROVENANCE_PATH} /workspace/oellm-autoexp/provenance/container_provenance.json

%post
mkdir -p /workspace/oellm-autoexp/provenance
mkdir -p /workspace/cache
cd /workspace

# NeMo's Python is the uv venv /opt/venv (system site-packages visible); everything goes
# into it with uv, as NeMo installs it.
uvpip() { uv pip install --python /opt/venv/bin/python --no-cache "$@"; }

/opt/venv/bin/python /workspace/oellm-autoexp/container/gen_constraints.py \
    --output /workspace/constraints.installed.txt \
    --exclude pip setuptools wheel huggingface_hub apache-tvm-ffi \
              tilelang nvidia-cutlass-dsl nvidia-cutlass-dsl-libs-base megatron-core

if [ -f "/workspace/${REQUIREMENTS_BASENAME}" ]; then
    uvpip -c /workspace/constraints.installed.txt -r "/workspace/${REQUIREMENTS_BASENAME}"
fi
uvpip -c /workspace/constraints.installed.txt -e /workspace/oellm-autoexp

# Our Megatron (submodules/Megatron-LM, oellm/v0.19-hybrid) comes from PYTHONPATH, as in the
# other hybrid images; NeMo's megatron-core 0.19.1 would shadow it.
uv pip uninstall --python /opt/venv/bin/python megatron-core || true

# ---------------------------------------------------------------------------
# Hybrid-architecture extras (oellm-autoexp feat/hybrid-v0.19). Already in NeMo and kept:
# NVRx, mamba_ssm / causal_conv1d, emerging-optimizers, DeepEP/HybridEP, NVSHMEM.
# ---------------------------------------------------------------------------
# The CuTe DSL cute-triadic-gdn / cute_kernels are built against (NeMo ships 4.5.0), and
# TileLang for the FLA TileLang paths (NeMo ships 0.1.8; its torch pin is overridden by the
# image's constraints).
uvpip -c /workspace/constraints.installed.txt "nvidia-cutlass-dsl[cu13]==4.7.1" cuda-python
uvpip -c /workspace/constraints.installed.txt "tilelang>=0.1.15"
uvpip --no-deps "git+https://github.com/OliverSieberling/cute-triadic-gdn"
# Liger's fused linear cross-entropy (liger_fused_linear_cross_entropy).
uvpip --no-deps "liger-kernel>=0.6"
# Power retention (the `power` linear variant): the public Triton kernels; vidrial only
# for its Python utilities (the CUDA backends are not used).
uvpip --no-deps "vidrial==0.2.1" "git+https://github.com/m-a-n-i-f-e-s-t/retention"
# vidrial clones its CUTLASS fork next to itself on first import; compute nodes are
# offline and site-packages is read-only at run time, so check it out here.
# (in Python: envsubst would blank a shell variable holding the path)
/opt/venv/bin/python - <<'PY'
import importlib.util, os, shutil, subprocess
dst = os.path.join(os.path.dirname(importlib.util.find_spec("vidrial").origin), "cutlass")
subprocess.check_call(["git", "clone", "--depth", "1", "https://github.com/m-a-n-i-f-e-s-t/cutlass.git", dst])
shutil.rmtree(os.path.join(dst, ".git"))
PY

# ---------------------------------------------------------------------------
# DeepEP with HybridEP: NeMo's build (the `deepep` / `hybridep` flex dispatcher backends).
# HybridEP JIT-compiles its kernels into <deep_ep>/build/jit at first use, which is
# read-only in the squashfs image: point it at a writable tmpfs directory instead.
# ---------------------------------------------------------------------------
/opt/venv/bin/python - <<'PY'
import os, shutil, importlib.util
pkg = os.path.dirname(importlib.util.find_spec("deep_ep").origin)
build = os.path.join(pkg, "build")
if not os.path.islink(build):
    if os.path.isdir(build):
        shutil.rmtree(build)
    elif os.path.exists(build):
        os.remove(build)
    os.symlink("/tmp/deep_ep_build", build)
PY

# ---------------------------------------------------------------------------
# Further EP libraries, best effort (a failing build leaves the image usable).
# ---------------------------------------------------------------------------
export TORCH_CUDA_ARCH_LIST="9.0;10.0"   # sm_90: H100/GH200, sm_100: B200/GB200
export MAX_JOBS=${MAX_JOBS:-16}
# MoonEP: CUDA extension + CuTe DSL kernels, NVLink-only (VMM-mapped peer buffers), no
# NVSHMEM. --no-deps: it pins nvidia-cutlass-dsl 4.6.2; the version above is kept.
uvpip --no-deps --no-build-isolation \
    "git+https://github.com/MoonshotAI/MoonEP.git@d86fda40329de4002e0cade6817df7b4b5512ee5" || \
    echo "WARNING: MoonEP not installed"
# UCCL-EP: DeepEP's Buffer API over GPU-initiated RDMA; its gain is across nodes (EFA,
# CX7 InfiniBand, Broadcom, AMD NICs).
git clone --depth 1 https://github.com/uccl-project/uccl.git /tmp/uccl && \
    (cd /tmp/uccl/ep && /opt/venv/bin/python setup.py install) || \
    echo "WARNING: UCCL-EP not installed"
rm -rf /tmp/uccl

# At run time: NeMo's venv first on PATH (apptainer drops `export PATH` from %environment,
# and the host PATH it forwards would otherwise pick a host / the system interpreter), and
# the HybridEP JIT cache directory.
mkdir -p /.singularity.d/env
cat > /.singularity.d/env/91-nemo-venv.sh << 'EOFENV'
#!/bin/bash
export PATH=/opt/venv/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/usr/local/sbin:/usr/sbin:/sbin:/bin:${PATH:-}
mkdir -p /tmp/deep_ep_build/jit 2>/dev/null || true
EOFENV
chmod +x /.singularity.d/env/91-nemo-venv.sh

rm -rf /root/.cache 2>/dev/null || true
uv cache clean 2>/dev/null || true

%runscript
cd /workspace/oellm-autoexp
exec "$@"

%startscript
cd /workspace/oellm-autoexp
exec "$@"

%test
# apptainer passes the host environment into %test; host cache dirs (e.g.
# TORCHINDUCTOR_CACHE_DIR=/mnt/data/...) are not writable here and break `import torch._dynamo`.
export TORCHINDUCTOR_CACHE_DIR=/tmp/oellm_test_cache/inductor
export TRITON_CACHE_DIR=/tmp/oellm_test_cache/triton
export TORCH_EXTENSIONS_DIR=/tmp/oellm_test_cache/torch_extensions
trap 'rm -rf /tmp/oellm_test_cache' EXIT   # /tmp is the host's here, not the image's
cd /workspace/oellm-autoexp
/opt/venv/bin/python scripts/run_autoexp.py --help >/dev/null
/opt/venv/bin/python - <<'PY'
import importlib.metadata as m
import torch
major, minor = (int(x) for x in torch.__version__.split(".")[:2])
assert (major, minor) >= (2, 12), torch.__version__
for mod in ("transformer_engine", "nvidia_resiliency_ext", "cutlass", "cute_triadic_gdn",
            "mamba_ssm", "causal_conv1d", "triton", "tilelang", "retention.triton",
            "liger_kernel", "emerging_optimizers"):
    __import__(mod)
try:
    import megatron.core  # noqa: F401
    raise SystemExit("NeMo's megatron-core is still installed; ours comes from PYTHONPATH")
except ImportError:
    pass
print("torch", torch.__version__, "| TE", m.version("transformer_engine"),
      "| cutlass-dsl", m.version("nvidia-cutlass-dsl"), "| tilelang", m.version("tilelang"),
      "| mamba-ssm", m.version("mamba-ssm"), "| nvrx", m.version("nvidia-resiliency-ext"))
PY
/opt/venv/bin/python - <<'PY'
import importlib.metadata as m
import deep_ep
from deep_ep import Buffer, HybridEPBuffer  # the flex dispatcher's deepep / hybridep backends
try:
    print("deep_ep", m.version("deep_ep"))
except m.PackageNotFoundError:
    print("deep_ep (version unknown)")
for name, mod in (("ncclep (TE NCCL EP)", "transformer_engine.pytorch.ep"),
                  ("MoonEP", "moonep"), ("UCCL-EP", "uccl.ep")):
    try:  # optional EP libraries: report, do not fail
        __import__(mod)
        print(name, "available")
    except Exception as e:
        print(name, "not available:", type(e).__name__, e)
PY

%help
    The hybrid-architecture image on NeMo 26.08.01 with DeepEP/HybridEP, MoonEP and UCCL-EP.
    Run with Megatron-LM, flash-linear-attention and cute_kernels from the synced checkout on
    PYTHONPATH; select an EP backend with moe_token_dispatcher_type=flex and
    moe_flex_dispatcher_backend=deepep|hybridep|ncclep.
