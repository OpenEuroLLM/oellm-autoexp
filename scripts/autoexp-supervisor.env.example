# Copy to ~/.config/autoexp/<cluster>.env and edit -- the BASENAME becomes the
# systemd instance name, so ~/.config/autoexp/jupiter.env is driven by
#   systemctl --user enable --now autoexp-supervisor@jupiter
# Consumed by scripts/autoexp-supervisor@.service. One file per cluster.

# Absolute path to supervise_monitor.sh in your LOCAL checkout.
SUPERVISOR_SCRIPT=/home/you/Projects/oellm-autoexp/scripts/supervise_monitor.sh

# How to reach the cluster. Must work non-interactively (BatchMode); test with
#   ssh jupiter true
# Leave EMPTY to supervise a monitor on this machine (used by the local tests).
SSH_PREFIX=ssh jupiter

# Repo root ON THE CLUSTER -- where monitor_probe.sh / monitor_launch.sh live.
REMOTE_REPO=/e/home/jusers/you/jupiter/work/Projects/oellm-autoexp

# Watch EVERY live session under this folder (recommended). Discovery keeps only
# sessions whose jobs are in the SLURM queue right now, so abandoned sessions are
# never resurrected. Leave SESSION empty when using this.
MONITOR_STATE_DIR=/e/home/jusers/you/jupiter/work/Projects/oellm-autoexp/monitor_state

# ...or pin to one session: <REMOTE_REPO>/monitor_state/<SESSION>. Leave empty
# when MONITOR_STATE_DIR is set.
SESSION=

POLL=60
STALE_AFTER=300
WEDGE_GRACE=600
RESTART_BUDGET=5

NOTIFY_EMAIL=you@example.org
