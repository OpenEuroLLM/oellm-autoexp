# Leonardo sketch: copy to leonardo.env and fill in. Only the container and path lines are site-specific;
# every step below `convert` is site-independent because it runs through oellm-eval, which already knows
# Leonardo (see oellm/resources/clusters.yaml: partition boost_usr_prod, account OELLM_prod2026).
SITE_NAME=leonardo
: "${ACCOUNT:=OELLM_prod2026}"
: "${PARTITION:=boost_usr_prod}"
: "${GPUS_PER_NODE:=4}"          # 4x A100 64GB
: "${CPUS_PER_TASK:=32}"
: "${SLURM_MEM:=400G}"
: "${CONTAINER_BIND:=/leonardo_work}"

# x86 builds of the same containers are required; the JUPITER ones are aarch64.
: "${TRAIN_SIF:=}"
: "${BRIDGE_SIF:=}"
: "${HF_EVAL_SIF:=/leonardo_work/AIFAC_L01_028/oellm-cli-shared-evals/eval_env-leonardo.sif}"
: "${REASONING_SIF:=}"           # no Leonardo build of oellm-eval-complete.sif yet
: "${REASONING_SIF_SHA256:=}"
: "${EVAL_REPO:=$HOME/oellm-eval}"
: "${EXPECTED_EVAL_REV:=}"
: "${EVAL_SHARED_RUNS:=/leonardo_work/AIFAC_L01_028/oellm-cli-shared-evals}"
