# JUPITER (GH200, aarch64). Sourced by eval_checkpoints.sh; every value may be overridden in the environment.
SITE_NAME=jupiter
: "${ACCOUNT:=e-ext-2025e02-108}"
: "${PARTITION:=booster}"
: "${GPUS_PER_NODE:=4}"
: "${CPUS_PER_TASK:=288}"        # whole node; independent of vLLM DP/TP
: "${SLURM_MEM:=400G}"
: "${CONTAINER_BIND:=/e}"        # filesystem root to bind into every container

# Containers
: "${TRAIN_SIF:=/e/project1/e-sta-openeurollm/container/MegatronTraining-JUPITER-te218-fa3_aarch64_202608280932.sif}"
: "${BRIDGE_SIF:=/e/project1/e-sta-openeurollm/container/MegatronTraining-JUPITER-bridge-bridge_aarch64_202605191331.sif}"
: "${HF_EVAL_SIF:=/e/data1/datasets/playground/mmlaion/shared/oellm_shared_evals/eval_env-jupiter.sif}"
: "${REASONING_SIF:=/e/fscratch/e-sta-openeurollm/jj1/eval_integrated_install_20260911/images/oellm-eval-complete.sif}"
: "${REASONING_SIF_SHA256:=5ae0222748346026ae311845664fec45adfea19a715f2b60eb661082973d06c2}"

# oellm-eval supplies the vLLM/Evalchemy runs. It is a submodule of this repository, pinned at
# tag v0.01; set EVAL_REPO to use your own checkout instead.
: "${EVAL_REPO:=$HERE/../../submodules/oellm-eval}"
# The expected revision is the submodule pin recorded in this repo, so a moved or dirty
# submodule is caught; pass EXPECTED_EVAL_REV explicitly when EVAL_REPO is your own checkout.
: "${EXPECTED_EVAL_REV:=$(git -C "$HERE" rev-parse --verify --quiet HEAD:submodules/oellm-eval || echo unknown)}"
# Shared oellm-eval output tree (the HF backend writes runs under $EVAL_SHARED_RUNS/$USER).
: "${EVAL_SHARED_RUNS:=/e/data1/datasets/playground/mmlaion/shared/oellm_shared_evals}"
