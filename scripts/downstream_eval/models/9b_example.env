# Template for another model size (9B dense). Copy to <name>.env, fill in, then: MODEL=<name> ./eval_checkpoints.sh ...
# Only this file changes between model families; every script below is shared.
MODEL_NAME=9b_example
: "${WORK_ROOT:=/e/scratch/e-sta-openeurollm/production_training/downstream_eval_9b}"

: "${HF_MODEL:=Qwen/Qwen3-8B   # closest HF layout; set to the one this model mirrors}"
: "${DERIVE_HF_ARCH:=qwen3}"
: "${ARCH_YAML:=$PROFILE_DIR/9b_example.arch.yaml}"   # num_layers/hidden_size/... from that run's training args
: "${TOKENIZER_SRC:=/e/data1/datasets/playground/mmlaion/oellm/oellm_tokenizer_256k}"
: "${VOCAB_SIZE:=262144}"
: "${MEGATRON_REPO:=/e/project1/e-sta-openeurollm/vanosch1/oellm-autoexp-dense}"
: "${CONVERT_TIME:=01:00:00}"

# A 9B fits on one GPU, so no data-parallel replicas are needed.
: "${EVAL_DP:=1}"
: "${EVAL_TP:=1}"
: "${EVAL_TIME:=01:00:00}"

RUNS=(
    # example:/path/to/run/checkpoints
)
ALIASES=()
