# 32B dense (OpenEuroLLM production + defer-off fork + B1-reborn). Values from the fork's training args.
MODEL_NAME=32b_dense
: "${WORK_ROOT:=/e/scratch/e-sta-openeurollm/production_training/downstream_eval_32b}"
# Exports are 64 GB each and regenerable in ~17 min, so they live under WORK_ROOT by default.
# Set EXPORT_ROOT to share one tree between people; prompt views follow it automatically.

# Conversion: Megatron torch_dist -> HF safetensors
: "${HF_MODEL:=Qwen/Qwen3-32B}"          # layout the exports imitate
: "${DERIVE_HF_ARCH:=qwen3}"
: "${ARCH_YAML:=$PROFILE_DIR/32b_dense.arch.yaml}"
: "${TOKENIZER_SRC:=/e/data1/datasets/playground/mmlaion/oellm/oellm_tokenizer_256k}"
: "${VOCAB_SIZE:=262144}"                # embedding rows; a <pad> beyond this is dropped
: "${MEGATRON_REPO:=/e/project1/e-sta-openeurollm/vanosch1/oellm-autoexp-dense}"   # Megatron-LM at the training commit
: "${CONVERT_TIME:=03:00:00}"

# Evaluation: a 32B needs a whole node, so vLLM runs 4 single-GPU replicas.
: "${EVAL_DP:=4}"
: "${EVAL_TP:=1}"
: "${EVAL_TIME:=01:00:00}"

# Training runs: label:checkpoint-dir. Any iteration of these can be evaluated as <label>:<iter>,
# e.g. v2:40000 or fork:latest; the export is then named <label>_<iter/1000>k.
RUNS=(
    v1:/e/scratch/e-sta-openeurollm/production_training/oellm_32b_dense_prod_dataopt5_gbs4096_lr3e-4/checkpoints
    v2:/e/scratch/e-sta-openeurollm/production_training/oellm_32b_v2_prod_gbs4096_lr1.76e-4/checkpoints
    fork:/e/scratch/e-sta-openeurollm/production_training/oellm_32b_dense_prod_dataopt5_deferoff_3e-4_i64k_seed1234/checkpoints
    b1:/e/fscratch/e-sta-openeurollm/jj1/reanimation_64k_20260911/B1-reborn-production/training_ckpts/checkpoints
    # v2 continues in a second directory from 60000 on, with unfused CE + z-loss: a different
    # configuration, so it gets its own label and its own series in any comparison.
    v2zloss:/e/scratch/e-sta-openeurollm/production_training/oellm_32b_v2_zloss_unfused_i60k_gbs4096_lr1.76e-4/checkpoints
)

# Names used by the published 2026-09 results, kept so existing exports and tables keep working.
ALIASES=(
    control_64k:v1:64000
    fork_76k:fork:76000
    fork_80k:fork:80000
    fork_86k:fork:86000
    b1_86k:b1:86000
    b1_110k:b1:110000
)
